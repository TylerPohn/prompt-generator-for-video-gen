{
  "name": "ai-video-lambda-functions",
  "version": "1.0.0",
  "description": "Lambda functions for AI video generation service",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:submit-job && npm run build:get-status && npm run build:process-job",
    "build:submit-job": "esbuild submit-job/index.ts --bundle --platform=node --target=node20 --outfile=dist/submit-job/index.js --external:@aws-sdk/*",
    "build:get-status": "esbuild get-status/index.ts --bundle --platform=node --target=node20 --outfile=dist/get-status/index.js --external:@aws-sdk/*",
    "build:process-job": "esbuild process-job/index.ts --bundle --platform=node --target=node20 --outfile=dist/process-job/index.js --external:@aws-sdk/*",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.709.0",
    "@aws-sdk/client-s3": "^3.709.0",
    "@aws-sdk/client-sqs": "^3.709.0",
    "@aws-sdk/lib-dynamodb": "^3.709.0",
    "@aws-sdk/s3-request-presigner": "^3.709.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.17.9",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "lambda",
    "aws",
    "typescript",
    "video-generation"
  ],
  "author": "",
  "license": "MIT"
}
